# =====================================================================
# Bodegas del Atuel - Variables de Entorno de Ejemplo
# Copiar este archivo a `.env` y ajustar los valores locales:
#   cp .env.example .env
#
# NUNCA subir el archivo `.env` con contraseñas reales al repositorio.
# =====================================================================

# --- Base de datos PostgreSQL (Servicio "db") ---
POSTGRES_DB=bodegas_atuel
POSTGRES_USER=owner_bodegas
POSTGRES_PASSWORD=cambiar_por_un_secreto
DB_PORT=5432

