# =====================================================================
# Bodegas del Atuel - Variables de Entorno de Ejemplo
#
# Copiar este archivo a `.env` y ajustar valores locales según corresponda:
#   cp .env.example .env
#
# NUNCA subir el archivo `.env` con contraseñas o datos reales al repositorio.
# El archivo `.env` está expresamente excluido por `.gitignore`.
# =====================================================================

# ---------------------------------------------------------------------
# PostgreSQL: Base de datos y rol propietario (migraciones y seed)
# ---------------------------------------------------------------------
# Nombre de la base de datos principal
POSTGRES_DB=bodegas_atuel
# Usuario propietario de la base de datos (con permisos para crear tablas y roles)
POSTGRES_USER=owner_bodegas
# Contraseña del rol propietario (usar una clave segura local, nunca contraseñas de producción)
POSTGRES_PASSWORD=cambiar_por_un_secreto_owner
# Puerto expuesto en el host (ajustar si el puerto 5432 local ya está ocupado)
DB_PORT=5432

# ---------------------------------------------------------------------
# Conexión de la API (rol de aplicación app_rw con privilegios mínimos)
# ---------------------------------------------------------------------
# Host de base de datos (en Docker Compose usa el nombre de servicio 'db'; en local 'localhost')
DB_HOST=db
# Nombre de la base de datos a la que se conecta la API
DB_NAME=bodegas_atuel
# Usuario de aplicación (lectura y escritura acotada; NUNCA el propietario ni superusuario)
DB_USER=app_rw
# Contraseña del usuario de aplicación
DB_PASSWORD=cambiar_por_un_secreto_app
# Alias para scripts de inicialización SQL y compatibilidad con Docker Compose
APP_DB_PASSWORD=cambiar_por_un_secreto_app

# ---------------------------------------------------------------------
# Parámetros avanzados del pool de conexiones (psycopg_pool)
# ---------------------------------------------------------------------
# Modo SSL: 'prefer' o 'disable' en desarrollo local; 'require' obligatorio en la nube
DB_SSLMODE=prefer
# Cantidad mínima de conexiones activas en el pool
DB_POOL_MIN=1
# Cantidad máxima de conexiones simultáneas en el pool
DB_POOL_MAX=10

# ---------------------------------------------------------------------
# Configuración del Backend (FastAPI / Uvicorn)
# ---------------------------------------------------------------------
# Puerto donde escucha la API REST
API_PORT=8000
# Orígenes permitidos para CORS (separados por coma, sin espacios)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ---------------------------------------------------------------------
# Configuración del Frontend Web
# ---------------------------------------------------------------------
# Puerto del servidor web del frontend (Nginx en contenedor)
FRONT_PORT=5173
# URL base pública de la API REST accesible desde el navegador cliente
API_BASE_URL=http://localhost:8000

# ---------------------------------------------------------------------
# Conexión Directa / Nube (Opcional, para scripts de migración o nube)
# ---------------------------------------------------------------------
# Formato estándar de URI de conexión utilizado por psql y proveedores cloud
# DATABASE_URL=postgresql://app_rw:CAMBIAR_POR_PASSWORD@localhost:5432/bodegas_atuel?sslmode=require
