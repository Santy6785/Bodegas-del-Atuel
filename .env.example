# =====================================================================
# Bodegas del Atuel - Variables de Entorno de Ejemplo
# Copiar este archivo a `.env` y ajustar valores locales:
#   cp .env.example .env
# NUNCA subir `.env` con contraseñas reales al repositorio.
# =====================================================================

# --- Contenedor PostgreSQL (rol propietario, solo para migraciones y seed) ---
POSTGRES_DB=bodegas_atuel
POSTGRES_USER=owner_bodegas
POSTGRES_PASSWORD=cambiar_por_un_secreto_owner
DB_PORT=5432

# --- Conexión de la API (rol app_rw, privilegios mínimos; NUNCA el propietario) ---
DB_HOST=db
DB_NAME=bodegas_atuel
DB_USER=app_rw
DB_PASSWORD=cambiar_por_un_secreto_app
# Alias para scripts de inicialización SQL
APP_DB_PASSWORD=cambiar_por_un_secreto_app

# Parámetros avanzados del pool de conexiones
DB_SSLMODE=prefer
DB_POOL_MIN=1
DB_POOL_MAX=10

# --- API REST ---
API_PORT=8000
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# --- Frontend ---
FRONT_PORT=5173
API_BASE_URL=http://localhost:8000
