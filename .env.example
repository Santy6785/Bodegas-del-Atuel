# =====================================================================
# Bodegas del Atuel - variables de entorno
#
# Copiar este archivo a `.env` y completar los valores reales:
#   cp .env.example .env
#
# NUNCA subir `.env` al repositorio (está excluido por .gitignore).
# El archivo docker-compose.yml lee de .env automáticamente.
# =====================================================================

# --- Base de datos PostgreSQL 16 ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_dev_cambiar_en_produccion
POSTGRES_DB=bodegas_del_atuel
DB_PORT=5432

# --- Rol de lectura/escritura para la API (nunca propietario ni superusuario) ---
# Esta contraseña se pasa a las migraciones (007_roles.sql) a través de la
# variable de psql `app_password` (-v app_password=...).
APP_DB_USER=app_rw
APP_DB_PASSWORD=app_rw_dev_cambiar_en_produccion

# --- API REST ---
API_PORT=8000
API_BASE_URL=http://localhost:8000

# --- Front ---
FRONT_PORT=5173
