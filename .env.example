# --- Contenedor PostgreSQL (rol propietario, solo para migraciones) ---
POSTGRES_DB=bodegas_atuel
POSTGRES_USER=owner_bodegas
POSTGRES_PASSWORD=cambiar_por_un_secreto

# --- Conexión de la API (rol app_rw, privilegios mínimos; NUNCA el propietario) ---
DB_HOST=db
DB_PORT=5432
DB_NAME=bodegas_atuel
DB_USER=app_rw
DB_PASSWORD=cambiar_por_un_secreto
# sslmode: prefer en local, require en la nube
DB_SSLMODE=prefer
DB_POOL_MIN=1
DB_POOL_MAX=10

# --- API ---
API_PORT=8000
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
