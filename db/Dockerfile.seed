# =====================================================================
# Dockerfile del servicio seed (perfil "seed")
#
# Ejecuta el script de carga de db/seed/ contra la base ya migrada.
# Según la especificación del repositorio, el script de carga usa Python
# (psycopg, Faker, semilla fija). Completar según el script real que
# aporten los integrantes de db/seed/.
# =====================================================================

FROM python:3-slim

# Dependencias del script de carga (psycopg v3 + Faker) con versiones fijas y estables
RUN pip install --no-cache-dir "psycopg[binary]==3.2.2" "faker==21.2.0"

WORKDIR /seed

# CSV del catalogo y script de carga (aportados por otros integrantes)
COPY db/seed/ ./

# Ejecuta el script de seeding contra PostgreSQL
CMD ["python", "/seed/seed.py"]
